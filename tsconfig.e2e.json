{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "e2e/**/*",
    "playwright.config.ts",
    "src/preload/index.d.ts",
    ".cursor/skills/verify-attn/drives/**/*",
    ".cursor/skills/verify-attn/playwright.config.ts"
  ]
}
