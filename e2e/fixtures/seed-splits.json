    {
      "id": "t-other-read",
      "messages": [
        {
          "id": "m-other-read",
          "labelIds": ["INBOX"],
          "receivedDaysAgo": 0,
          "receivedAt": "09:00",
          "from": "Jo Park <jo@example.com>",
          "to": "splits@attn.test",
          "subject": "Weekend walk",
          "snippet": "The trail should be quiet.",
          "bodyText": "The trail should be quiet this weekend."
        }
      ]
