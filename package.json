{
  "name": "attn",
  "productName": "Attn",
  "version": "0.0.1",
  "description": "Attn — keyboard-first, local-first desktop email client for macOS and Windows",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "biome check .",
    "test:unit": "vitest run src/main",
    "e2e": "npm run build && node scripts/run-e2e.mjs",
    "e2e:only": "node scripts/run-e2e.mjs",
    "verify": "npm run typecheck && npx biome ci . && npm run test:unit && npm run e2e",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "postinstall": "node scripts/ensure-electron-toolchain.mjs",
    "toolchain": "node scripts/ensure-electron-toolchain.mjs",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@electron/rebuild": "^4.2.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.3.0",
    "electron-vite": "^5.0.0",
    "lefthook": "^2.1.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "better-sqlite3": "^13.0.3",
    "dompurify": "^3.4.13",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
